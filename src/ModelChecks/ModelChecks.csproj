<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">F:\SteamLibrary\steamapps\common\Monster Train 2</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Model\Model.csproj" />
    <ProjectReference Include="..\FixtureArchive\FixtureArchive.csproj" />
    <Compile Include="../NativeCasePlans/*.cs" Link="NativeCasePlans/%(Filename)%(Extension)" />
    <Compile Include="..\Probe\NativeFixtureCapture.cs" Link="NativeFixtureCapture.cs" />
    <Compile Include="..\Probe\AdviceDiagnosticJournal.cs" Link="Advisor/AdviceDiagnosticJournal.cs" />
    <Compile Include="..\Probe\AdvisorObservationPreparation.cs" Link="Advisor/AdvisorObservationPreparation.cs" />
    <Compile Include="..\Probe\AdvisorForecastPresentation.cs" Link="Advisor/AdvisorForecastPresentation.cs" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameDir)\MonsterTrain2_Data\Managed\Newtonsoft.Json.dll" />
  </ItemGroup>
</Project>
